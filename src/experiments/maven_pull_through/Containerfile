ARG BASE_TAG=latest
FROM pulp/pulp-ci-centos10:${BASE_TAG} AS collector-builder

COPY src/pulp_juicer/collector /tmp/collector
RUN --mount=type=cache,id=pulp-juicer-rpm-uv,target=/root/.cache/uv \
    uv run --no-project --with rpm-rs==0.30.2 \
      python /tmp/collector/build_rpm.py /tmp/collector

FROM pulp/pulp-ci-centos10:${BASE_TAG}

COPY --from=collector-builder /tmp/collector/pulp-juicer-collector-0.4.0-1.noarch.rpm /tmp/
RUN rpm -i /tmp/pulp-juicer-collector-0.4.0-1.noarch.rpm && \
    rm /tmp/pulp-juicer-collector-0.4.0-1.noarch.rpm

# Compose provides each checked-out repository as a named build context.
COPY --from=pulpcore_src / /opt/pulp-sources/pulpcore/
COPY --from=maven_src / /opt/pulp-sources/pulp_maven/

RUN --mount=type=cache,id=bucket-loadtest-uv,target=/root/.cache/uv \
    UV_LINK_MODE=copy uv pip install --system \
      --refresh-package pulpcore --refresh-package pulp-maven \
      /opt/pulp-sources/pulpcore \
      /opt/pulp-sources/pulp_maven \
      pyarrow==26.0.0 \
      -c /constraints.txt

USER pulp:pulp
RUN PULP_STATIC_ROOT=/var/lib/operator/static/ PULP_CONTENT_ORIGIN=localhost \
    /usr/local/bin/pulpcore-manager collectstatic --clear --noinput --link
USER root:root
